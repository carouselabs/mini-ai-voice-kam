# Copy this file to server/.env and fill in the key. server/.env is git-ignored.
# The key stays on the server: it is never sent to the browser or returned by the API.

# openai (real model) or mock (scripted test model, for automated tests only)
AI_PROVIDER=openai

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional. Leave empty and the server picks the newest available "mini" GPT model for your key
# at startup (checked against the API). Set it to pin a model, for example a model ID shown by
# GET /api/ai/health.
OPENAI_MODEL=

# Optional: minimal | low | medium | high (only for reasoning models). Defaults to low for reasoning models.
OPENAI_REASONING_EFFORT=

# Maximum rounds of data-tool calls per answer (1–12).
AI_MAX_TOOL_ROUNDS=8

# Timeout for each model request, in milliseconds.
AI_REQUEST_TIMEOUT_MS=45000

# AI requests allowed per client every 5 minutes (default 40). The test server raises it.
AI_RATE_LIMIT=

# Where the action tracker and seller memory are saved (default server/runtime).
MINI_AI_RUNTIME_DIR=

# ---- Live voice (OpenAI Realtime over WebRTC). Uses OPENAI_API_KEY above; the key never reaches the browser. ----
# Model (default gpt-realtime-2.1). gpt-realtime-2.1-mini is cheaper.
OPENAI_REALTIME_MODEL=
# Voice (default marin): alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar.
OPENAI_REALTIME_VOICE=
# Speech recognition model for the transcript (default gpt-transcribe).
OPENAI_REALTIME_TRANSCRIBE_MODEL=
# Reasoning effort for voice answers: minimal, low (default), medium, high.
OPENAI_REALTIME_REASONING=
# End-of-turn detection: semantic:high (default), semantic:auto, or server:700 (ms of silence).
OPENAI_REALTIME_TURN_DETECTION=
